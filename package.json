{
  "name": "katha",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.6.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "turbo": "2.11.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "scripts": {
    "lint": "turbo run lint lint:root",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint:root": "eslint eslint.config.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:start": "docker compose up --detach --wait",
    "db:status": "docker compose ps",
    "db:stop": "docker compose down"
  }
}
