{
  "name": "katha",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.6.0"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "1.5.6",
    "@codama/renderers-js": "2.5.0",
    "@eslint/js": "10.0.1",
    "codama": "1.11.0",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "turbo": "2.11.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "scripts": {
    "program:build": "NO_DNA=1 anchor build --ignore-keys",
    "codegen": "node scripts/generate-program-clients.mjs",
    "codegen:check": "node scripts/generate-program-clients.mjs --check",
    "lint": "turbo run lint lint:root",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint:root": "eslint eslint.config.mjs scripts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "program:test": "node scripts/test-core-cpi.mjs",
    "db:start": "docker compose up --detach --wait",
    "db:status": "docker compose ps",
    "db:stop": "docker compose down",
    "db:generate": "pnpm --filter @katha/db db:generate",
    "db:migrate": "pnpm --filter @katha/db db:migrate",
    "db:test": "node scripts/test-database.mjs"
  }
}
