# Disposable local development values. Copy to .env and choose your own password.
KATHA_DB_USER=katha_dev
KATHA_DB_PASSWORD=local-dev-only-change-me
KATHA_DB_NAME=katha_dev
KATHA_DB_PORT=5432

# Match the Compose user, password, name and port above; percent-encode credentials.
# Server/CLI only. Never use a NEXT_PUBLIC_ prefix or commit a real URL.
DATABASE_URL=postgres://katha_dev:local-dev-only-change-me@127.0.0.1:5432/katha_dev
