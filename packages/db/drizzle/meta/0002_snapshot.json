          "name": "artists_creator_wallet_format",
          "value": "\"artists\".\"creator_wallet\" IS NULL OR \"artists\".\"creator_wallet\" ~ '^[1-9A-HJ-NP-Za-km-z]{32,44}$'"
        },
        "artists_payout_wallet_format": {
