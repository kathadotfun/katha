        }
      },
      "policies": {},
      "checkConstraints": {
        "artists_slug_format": {
          "name": "artists_slug_format",
          "value": "\"artists\".\"slug\" ~ '^[a-z0-9]+(-[a-z0-9]+)*$'"
        },
        "artists_display_name_nonblank": {
          "name": "artists_display_name_nonblank",
          "value": "\"artists\".\"display_name\" ~ '[^[:space:]]'"
        },
        "artists_biography_nonblank": {
          "name": "artists_biography_nonblank",
          "value": "\"artists\".\"biography\" ~ '[^[:space:]]'"
        },
        "artists_region_nonblank": {
          "name": "artists_region_nonblank",
          "value": "\"artists\".\"region\" ~ '[^[:space:]]'"
        },
        "artists_traditions_valid": {
          "name": "artists_traditions_valid",
          "value": "cardinality(\"artists\".\"traditions\") BETWEEN 1 AND 20 AND array_ndims(\"artists\".\"traditions\") = 1 AND array_position(\"artists\".\"traditions\", NULL) IS NULL AND array_to_string(\"artists\".\"traditions\", chr(31)) !~ ('(^|' || chr(31) || ')[[:space:]]*(' || chr(31) || '|$)')"
        },
        "artists_public_links_valid": {
          "name": "artists_public_links_valid",
          "value": "cardinality(\"artists\".\"public_links\") <= 10 AND coalesce(array_ndims(\"artists\".\"public_links\"), 1) = 1 AND array_position(\"artists\".\"public_links\", NULL) IS NULL AND (cardinality(\"artists\".\"public_links\") = 0 OR array_to_string(\"artists\".\"public_links\", chr(31)) ~ ('^https?://[^[:space:]' || chr(31) || ']+(' || chr(31) || 'https?://[^[:space:]' || chr(31) || ']+)*$'))"
        },
        "artists_profile_image_url_format": {
          "name": "artists_profile_image_url_format",
          "value": "\"artists\".\"profile_image_url\" IS NULL OR \"artists\".\"profile_image_url\" ~ '^https?://[^[:space:]]+$'"
        },
        "artists_creator_wallet_format": {
          "name": "artists_creator_wallet_format",
          "value": "\"artists\".\"creator_wallet\" IS NULL OR \"artists\".\"creator_wallet\" ~ '^[1-9A-HJ-NP-Za-km-z]{32,44}$'"
        },
        "artists_payout_wallet_format": {
          "name": "artists_payout_wallet_format",
          "value": "\"artists\".\"payout_wallet\" IS NULL OR \"artists\".\"payout_wallet\" ~ '^[1-9A-HJ-NP-Za-km-z]{32,44}$'"
        },
        "artists_verifier_wallet_format": {
          "name": "artists_verifier_wallet_format",
          "value": "\"artists\".\"verified_by_wallet\" IS NULL OR \"artists\".\"verified_by_wallet\" ~ '^[1-9A-HJ-NP-Za-km-z]{32,44}$'"
        },
        "artists_manual_verification_complete": {
          "name": "artists_manual_verification_complete",
          "value": "(\"artists\".\"verification_status\" = 'UNVERIFIED' AND \"artists\".\"verified_by_wallet\" IS NULL AND \"artists\".\"verified_at\" IS NULL) OR (\"artists\".\"verification_status\" = 'VERIFIED' AND \"artists\".\"verified_by_wallet\" IS NOT NULL AND \"artists\".\"verified_at\" IS NOT NULL)"
        },
        "artists_timestamp_order": {
          "name": "artists_timestamp_order",
          "value": "\"artists\".\"updated_at\" >= \"artists\".\"created_at\" AND (\"artists\".\"verified_at\" IS NULL OR \"artists\".\"verified_at\" BETWEEN \"artists\".\"created_at\" AND \"artists\".\"updated_at\")"
        }
      },
      "isRLSEnabled": false
    }
