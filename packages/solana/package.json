{
  "name": "@katha/solana",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./registry": {
      "types": "./dist/generated/registry/index.d.ts",
      "import": "./dist/generated/registry/index.js"
    },
    "./marketplace": {
      "types": "./dist/generated/marketplace/index.d.ts",
      "import": "./dist/generated/marketplace/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rpc-cluster": {
      "types": "./dist/rpc-cluster.d.ts",
      "import": "./dist/rpc-cluster.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude tests/core-cpi.test.ts --exclude tests/registry-config.test.ts --exclude tests/admin-lifecycle.test.ts --exclude tests/marketplace-fixtures.test.ts --exclude tests/marketplace-config.test.ts --exclude tests/marketplace-eligibility.test.ts --exclude tests/marketplace-listing.test.ts",
    "program:typecheck": "tsc -p tsconfig.tests.json --noEmit"
  },
  "devDependencies": {
    "@solana-program/token": "0.17.0",
    "@solana/kit-plugin-litesvm": "0.19.0",
    "@solana/kit-plugin-signer": "0.19.0",
    "@types/node": "24.19.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "@katha/shared": "workspace:*",
    "@metaplex-foundation/mpl-core": "1.10.0",
    "@metaplex-foundation/umi": "1.6.0",
    "@noble/hashes": "1.8.0",
    "@solana/kit": "8.4.0",
    "@solana/kit-plugin-rpc": "0.19.0"
  }
}
